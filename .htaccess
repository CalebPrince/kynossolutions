DirectoryIndex index.php
Options -Indexes

# Private files and directories are never served.
<FilesMatch "^(config\.php|config\.php\.example|database.*\.sql|security-baseline\.yaml|README\.md|ARCHITECTURE\.md|GUI\.md|SECURITY\.md|.*\.md|.*\.yaml|.*\.yml|.*\.json)$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(app|tests)/ - [F,L,NC]

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
    Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>
